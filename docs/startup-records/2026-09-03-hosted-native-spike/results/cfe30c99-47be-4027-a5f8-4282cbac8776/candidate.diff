 """The quoting contract every storefront service prices against."""
 
+import re
 from dataclasses import dataclass
 
+# ISO 4217 currencies with no minor (cent) units. Amounts are quoted in whole
+# major units and must therefore be rounded to the nearest integer.
+_ZERO_DECIMAL_CURRENCIES = frozenset({"JPY", "KRW", "VND"})
+
+_DEFAULT_CURRENCY = "USD"
+
+_CURRENCY_CODE = re.compile(r"^[A-Za-z]{3}$")
+
 
 @dataclass(frozen=True)
 class LineItem:
@@ -17,6 +26,20 @@ class LineItem:
 @dataclass(frozen=True)
 class Quote:
     amount: float
+    currency: str
+
+
+def _normalize_currency(currency: str) -> str:
+    """Validate an ISO 4217-style code and return it upper-cased.
+
+    The code must be exactly three ASCII letters; anything else (wrong length,
+    digits, punctuation, empty) is rejected with ``ValueError``.
+    """
+    if not isinstance(currency, str) or not _CURRENCY_CODE.match(currency):
+        raise ValueError(
+            f"currency must be a three-letter ASCII ISO 4217 code, got {currency!r}"
+        )
+    return currency.upper()
 
 
