REPOMESH_ENVIRONMENT=development
REPOMESH_LOG_LEVEL=INFO
REPOMESH_DATABASE_URL=postgresql+asyncpg://repomesh:repomesh@localhost:5432/repomesh

REPOMESH_AGENTTEAMS_REQUIRED=false
REPOMESH_AGENTTEAMS_CONTROLLER_URL=http://localhost:8090
REPOMESH_AGENTTEAMS_CONTROLLER_TOKEN=
REPOMESH_AGENTTEAMS_MATRIX_URL=http://localhost:6167
REPOMESH_AGENTTEAMS_MATRIX_ACCESS_TOKEN=
REPOMESH_RUNNER_CONTROL_TOKEN=
REPOMESH_AGENT_ACTION_TOKEN=
REPOMESH_WORKER_TASK_CONTROL_URL=
REPOMESH_AGENTTEAMS_STORAGE_ROOT=.agentteams-storage
REPOMESH_AGENTTEAMS_STORAGE_ENDPOINT=
REPOMESH_AGENTTEAMS_STORAGE_ACCESS_KEY=
REPOMESH_AGENTTEAMS_STORAGE_SECRET_KEY=
REPOMESH_AGENTTEAMS_STORAGE_BUCKET=agentteams-storage
REPOMESH_MCP_GATEWAY_TOKEN=
REPOMESH_DIRECT_WORKER_MCP_ENABLED=false
REPOMESH_RUNNER_WORKSPACE_ROOT=.repomesh-workspaces
REPOMESH_CAPABILITY_ROOT=.

# Consumed by the official AgentTeams installer.
AGENTTEAMS_NON_INTERACTIVE=1
AGENTTEAMS_VERSION=v1.2.0
AGENTTEAMS_MATRIX_APPSERVICE_ENABLED=0
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_LLM_PROVIDER=openai-compat
AGENTTEAMS_DEFAULT_MODEL=qwen3.6-plus
AGENTTEAMS_OPENAI_BASE_URL=
AGENTTEAMS_LLM_API_KEY=
