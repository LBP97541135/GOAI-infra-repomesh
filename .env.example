REPOMESH_SCM_COMMAND_DISPATCH_INTERVAL_SECONDS=5
REPOMESH_SCM_COMMAND_LEASE_SECONDS=300
REPOMESH_SCM_COMMAND_LEASE_RENEW_INTERVAL_SECONDS=60
REPOMESH_WORKER_EXECUTION_RESERVATION_LEASE_SECONDS=300
REPOMESH_WORKER_EXECUTION_RESERVATION_WAIT_SECONDS=30
REPOMESH_WORKER_RECOVERY_ENABLED=false
REPOMESH_WORKER_RECOVERY_SCAN_INTERVAL_SECONDS=15
REPOMESH_WORKER_RECOVERY_GRACE_SECONDS=60
REPOMESH_WORKER_RECOVERY_MAX_EXECUTION_ATTEMPTS=3
REPOMESH_WORKER_RECOVERY_MAX_REASSIGNMENTS=2

