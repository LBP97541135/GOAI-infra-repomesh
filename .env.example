AGENTTEAMS_NON_INTERACTIVE=1
AGENTTEAMS_VERSION=v1.2.0
AGENTTEAMS_MATRIX_APPSERVICE_ENABLED=0
AGENTTEAMS_ADMIN_USER=admin
AGENTTEAMS_LLM_PROVIDER=openai-compat
# Optional advanced overrides. Leave blank to inherit REPOMESH_MODEL_*.
AGENTTEAMS_DEFAULT_MODEL=
AGENTTEAMS_OPENAI_BASE_URL=
AGENTTEAMS_LLM_API_KEY=

# Optional RepoMesh-planning overrides. Most deployments should leave these blank.
REPOMESH_DEEPSEEK_API_KEY=
REPOMESH_DEEPSEEK_BASE_URL=
REPOMESH_DEEPSEEK_MODEL=
