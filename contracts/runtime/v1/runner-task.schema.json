{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repomesh.dev/contracts/runtime/v1/runner-task.schema.json",
  "title": "RepoMesh Runner Task v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "organizationId",
    "projectId",
    "taskId",
    "runId",
    "correlationId",
    "attempt",
    "adapterId",
    "instruction",
    "repository",
    "contextBundle",
    "permissions",
    "idempotencyKey",
    "issuedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "runtime.v1"},
    "organizationId": {"type": "string", "format": "uuid"},
    "projectId": {"type": "string", "format": "uuid"},
    "taskId": {"type": "string", "format": "uuid"},
    "runId": {"type": "string", "format": "uuid"},
    "correlationId": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "adapterId": {"type": "string", "minLength": 1, "maxLength": 100},
    "instruction": {"type": "string", "minLength": 1, "maxLength": 20000},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "url", "baseRevision"],
      "properties": {
        "repositoryId": {"type": "string", "format": "uuid"},
        "url": {"type": "string", "format": "uri"},
        "baseRevision": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "workspace": {
      "description": "Workspace prepared by the platform before dispatch. When present it is the single source of truth for where execution happens and at which base revision; repository.url and repository.baseRevision are then reference metadata only and the Runner never clones.",
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["workspaceId", "path", "baseSha"],
      "properties": {
        "workspaceId": {"type": "string", "minLength": 1, "maxLength": 200},
        "path": {
          "description": "Absolute path prepared by the platform; existence is verified by the Runner executor, not by this contract.",
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "baseSha": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "contextBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "version", "manifestUri", "contentHash"],
      "properties": {
        "bundleId": {"type": "string", "format": "uuid"},
        "version": {"type": "integer", "minimum": 1},
        "manifestUri": {"type": "string", "format": "uri"},
        "contentHash": {"$ref": "#/$defs/sha256"},
        "codingPackageHash": {
          "description": "Content hash of the coding package materialized into the workspace, when the bundle carries one.",
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "allowedTools", "disallowedTools", "networkTargets"],
      "properties": {
        "mode": {
          "enum": ["default", "accept_edits", "auto", "bypass_permissions"]
        },
        "allowedTools": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "disallowedTools": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "networkTargets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "allowedPaths": {
          "description": "Paths the adapter may read and write, relative to the assigned workspace.",
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "deniedPaths": {
          "description": "Paths the adapter may never touch. Denial applies in every permission mode.",
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "resumeSessionId": {"type": ["string", "null"], "maxLength": 500},
    "credentialRefs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 300},
      "uniqueItems": true
    },
    "workerAgentId": {
      "description": "AgentTeams worker agent the task is assigned to, when the platform pins one.",
      "type": ["string", "null"],
      "format": "uuid"
    },
    "testCommands": {
      "description": "Verification commands the Runner runs in the workspace after the adapter finishes.",
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "idempotencyKey": {"type": "string", "minLength": 1, "maxLength": 200},
    "issuedAt": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
